{
    "name": "container-reconcile",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "postCreateCommand": "pip install --user -r requirements.txt && ansible-galaxy collection install -r requirements.yaml",
    "customizations": {
        "vscode": {
            "extensions": [
                "redhat.ansible",
                "redhat.vscode-yaml",
                "ms-python.python",
                "ms-python.black-formatter",
                "ms-python.flake8",
                "ms-python.mypy-type-checker"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.pytestEnabled": true,
                "python.testing.pytestArgs": [
                    "tests"
                ],
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.formatOnSave": true
                },
                "yaml.schemas": {
                    "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json": [
                        "playbooks/**/*.yml",
                        "playbooks/**/*.yaml",
                        "roles/**/tasks/*.yml",
                        "roles/**/handlers/*.yml"
                    ]
                }
            }
        }
    },
    "remoteUser": "vscode"
}
